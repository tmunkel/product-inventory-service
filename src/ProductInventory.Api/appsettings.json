{
  "ConnectionStrings": {
    "Inventory": "Host=localhost;Port=5433;Database=product_inventory;Username=inventory;Password=inventory"
  },
  "ImageStorage": {
    "Path": "data/images",
    "MaxBytes": 5242880
  },
  "OpenFoodFacts": {
    "BaseUrl": "https://world.openfoodfacts.org/",
    "UserAgent": "ProductInventoryService/1.0 (self-hosted grocery app)"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
